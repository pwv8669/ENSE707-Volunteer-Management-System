@implements IDisposable

@using System.Security.Claims
@using WebApp.Data
@using WebApp.Services.Scheduling
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthenticationStateProvider
@inject VolunteerSchedulePersistenceService ScheduleService

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">WebApp</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="auth">
                <span class="bi bi-lock-nav-menu" aria-hidden="true"></span> Auth Required
            </NavLink>
        </div>

        <AuthorizeView Context="authContext">
            <Authorized>
                @* Added for Feature 2:
                   All signed-in users can view volunteer opportunities. *@
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="opportunities">
                        <span class="bi bi-list-task-nav-menu" aria-hidden="true"></span> Opportunities
                    </NavLink>
                </div>

                @* Added for Feature 3:
                   Volunteers can view their submitted applications. *@
                <AuthorizeView Roles="Volunteer" Context="volunteerRoleContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="my-applications">
                            <span class="bi bi-file-earmark-text-nav-menu" aria-hidden="true"></span> My Applications
                        </NavLink>
                    </div>

                    @* Added for Feature 5:
                       Volunteers can view assigned shifts and unread shift notifications. *@
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="my-schedule">
                            <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> My Schedule
                            @if (unreadShiftNotificationCount > 0)
                            {
                                <span class="badge rounded-pill bg-danger ms-1">
                                    @unreadShiftNotificationCount
                                </span>
                            }
                        </NavLink>
                    </div>

                    @* Added for Feature 6:
                       Volunteers can review recorded attendance and hours. *@
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="my-participation">
                            <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> My Participation
                        </NavLink>
                    </div>
                </AuthorizeView>

                @* Added for Feature 4:
                   Coordinators and Organisation Administrators can review
                   applications and manage volunteer assignments. *@
                <AuthorizeView Roles="Coordinator,OrganisationAdministrator" Context="managerRoleContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="assignments">
                            <span class="bi bi-people-nav-menu" aria-hidden="true"></span> Volunteer Assignments
                        </NavLink>
                    </div>

                    @* Added for Feature 6:
                       Managers record attendance and completed hours. *@
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="attendance">
                            <span class="bi bi-check2-square-nav-menu" aria-hidden="true"></span> Attendance &amp; Hours
                        </NavLink>
                    </div>
                </AuthorizeView>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="profile">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> My profile
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="reporting">
                        <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Reporting and Dashboard
                    </NavLink>
                </div>
                <AuthorizeView Roles="@AppRoles.OrganisationAdministrator" Context="administratorContext">
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="admin/users">
                            <span class="bi bi-people-fill-nav-menu" aria-hidden="true"></span> Manage user roles
                        </NavLink>
                    </div>
                </AuthorizeView>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Manage">
                        <span class="bi bi-person-fill-nav-menu" aria-hidden="true"></span> @authContext.User.Identity?.Name
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <form action="Account/Logout" method="post">
                        <AntiforgeryToken />
                        <input type="hidden" name="ReturnUrl" value="@currentUrl" />
                        <button type="submit" class="nav-link">
                            <span class="bi bi-arrow-bar-left-nav-menu" aria-hidden="true"></span> Logout
                        </button>
                    </form>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Register">
                        <span class="bi bi-person-nav-menu" aria-hidden="true"></span> Register
                    </NavLink>
                </div>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="bi bi-person-badge-nav-menu" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private string? currentUrl;
    private string? currentVolunteerId;
    private int unreadShiftNotificationCount;

    protected override async Task OnInitializedAsync()
    {
        currentUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
        NavigationManager.LocationChanged += OnLocationChanged;
        ScheduleService.ScheduleChanged += OnScheduleChanged;

        AuthenticationState state =
            await AuthenticationStateProvider.GetAuthenticationStateAsync();
        if (state.User.IsInRole(AppRoles.Volunteer))
        {
            currentVolunteerId =
                state.User.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            await RefreshUnreadCountAsync();
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        currentUrl = NavigationManager.ToBaseRelativePath(e.Location);
        _ = InvokeAsync(async () =>
        {
            await RefreshUnreadCountAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshUnreadCountAsync()
    {
        unreadShiftNotificationCount =
            currentVolunteerId is null
                ? 0
                : await ScheduleService
                    .GetUnreadNotificationCountAsync(
                        currentVolunteerId);
    }

    // Persisted schedule changes can originate from a coordinator's Blazor
    // circuit, so only the affected volunteer's badge is refreshed here.
    private void OnScheduleChanged(string volunteerId)
    {
        if (!string.Equals(
            currentVolunteerId,
            volunteerId,
            StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        _ = InvokeAsync(async () =>
        {
            await RefreshUnreadCountAsync();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        ScheduleService.ScheduleChanged -= OnScheduleChanged;
    }
}
