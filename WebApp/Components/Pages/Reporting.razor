@page "/reporting"
@attribute [Authorize(Roles = "Coordinator,OrganisationAdministrator")]
@using Volunteer_Management_System
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Identity
@using WebApp.Data
@using WebApp.Services.Activity
@inject ReportingService ReportingService
@inject VolunteerOpportunityService OpportunityService
@inject VolunteerActivitySyncService ActivitySync
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Reporting> Logger

@* Reporting and Dashboard page: shows volunteer participation, event statistics, and pending/fulfilled requests.
   The figures are rebuilt from the real volunteer applications and the saved attendance each time the page opens or is refreshed. *@
<PageTitle>Reporting and Dashboard</PageTitle>

<h1>Reporting and Dashboard</h1>

<p class="text-muted">
    A request is a volunteer's application to an event. <strong>Pending</strong> means it is waiting for a coordinator,
    <strong>Fulfilled</strong> means it was approved and the volunteer assigned, and <strong>Declined</strong> means it was
    rejected or the assignment was cancelled. Hours come from the attendance recorded by coordinators.
</p>

<div class="mb-3">
    <button class="btn btn-sm btn-outline-secondary" @onclick="RefreshDataAsync">Refresh</button>
    <a class="btn btn-sm btn-outline-primary" href="assignments">Review applications</a>
</div>

@* Shown when the latest data couldn't be loaded (for example the database is unreachable); the figures below may be out of date. *@
@if (!string.IsNullOrEmpty(LoadError))
{
    <div class="alert alert-warning" role="alert">@LoadError</div>
}

@* Participation report: one row per volunteer with their request counts and hours. *@
<h2>Volunteer Participation Report</h2>
<table class="table">
    <thead>
        <tr>
            <th>Volunteer</th>
            <th>Total Requests</th>
            <th>Fulfilled</th>
            <th>Pending</th>
            <th>Declined</th>
            <th>Hours Logged</th>
        </tr>
    </thead>
    <tbody>
        @foreach (VolunteerParticipationSummary summary in ParticipationReport)
        {
            <tr>
                <td>@VolunteerName(summary.VolunteerId)</td>
                <td>@summary.TotalRequests</td>
                <td>@summary.FulfilledRequests</td>
                <td>@summary.PendingRequests</td>
                <td>@summary.DeclinedRequests</td>
                <td>@summary.TotalHoursLogged</td>
            </tr>
        }
        @if (ParticipationReport.Count == 0)
        {
            <tr><td colspan="6" class="text-muted">No volunteer requests yet.</td></tr>
        }
    </tbody>
</table>

@* Event statistics: one row per opportunity with its request counts and hours. *@
<h2>Event Statistics &amp; Volunteer Hours</h2>
<table class="table">
    <thead>
        <tr>
            <th>Event</th>
            <th>Volunteers Needed</th>
            <th>Requests Received</th>
            <th>Fulfilled</th>
            <th>Pending</th>
            <th>Declined</th>
            <th>Hours Logged</th>
        </tr>
    </thead>
    <tbody>
        @foreach (EventStatistics statistics in EventStatisticsList)
        {
            <tr>
                <td>@statistics.Title</td>
                <td>@statistics.VolunteersNeeded</td>
                <td>@statistics.RequestsReceived</td>
                <td>@statistics.FulfilledRequests</td>
                <td>@statistics.PendingRequests</td>
                <td>@statistics.DeclinedRequests</td>
                <td>@statistics.TotalHoursLogged</td>
            </tr>
        }
        @if (EventStatisticsList.Count == 0)
        {
            <tr><td colspan="7" class="text-muted">No volunteer opportunities yet.</td></tr>
        }
    </tbody>
</table>

@* Pending requests on the left, fulfilled requests on the right. Approving or rejecting is done on the Volunteer Assignments page. *@
<div class="row">
    <div class="col-md-6">
        <h2>Pending Volunteer Requests</h2>
        <ul class="list-group">
            @foreach (VolunteerRequest request in PendingRequests)
            {
                <li class="list-group-item">
                    @VolunteerName(request.VolunteerId) &rarr; @OpportunityTitle(request.OpportunityId)
                </li>
            }
            @if (PendingRequests.Count == 0)
            {
                <li class="list-group-item text-muted">No pending requests.</li>
            }
        </ul>
    </div>
    <div class="col-md-6">
        <h2>Fulfilled Volunteer Requests</h2>
        <ul class="list-group">
            @foreach (VolunteerRequest request in FulfilledRequests)
            {
                <li class="list-group-item">
                    @VolunteerName(request.VolunteerId) &rarr; @OpportunityTitle(request.OpportunityId)
                    (@request.HoursLogged hrs)
                </li>
            }
            @if (FulfilledRequests.Count == 0)
            {
                <li class="list-group-item text-muted">No fulfilled requests yet.</li>
            }
        </ul>
    </div>
</div>

@code {
    // Data shown on the page, reloaded by RefreshDataAsync().
    private IReadOnlyList<VolunteerParticipationSummary> ParticipationReport { get; set; } = [];
    private List<EventStatistics> EventStatisticsList { get; set; } = [];
    private IReadOnlyList<VolunteerRequest> PendingRequests { get; set; } = [];
    private IReadOnlyList<VolunteerRequest> FulfilledRequests { get; set; } = [];
    // Cache of volunteer id to display name, so each user is only looked up once.
    private readonly Dictionary<Guid, string> _volunteerNames = new();
    // Message shown when the latest data couldn't be loaded; null hides it.
    private string? LoadError { get; set; }

    // Loads the report data when the page first opens.
    protected override async Task OnInitializedAsync()
    {
        await RefreshDataAsync();
    }

    // Brings the requests up to date with the real applications and attendance, then reloads every report
    // and looks up names for any new volunteers. If the database can't be reached, the last known figures stay on screen with a warning.
    private async Task RefreshDataAsync()
    {
        try
        {
            await ActivitySync.RefreshAsync();
            LoadError = null;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to refresh the reporting data.");
            LoadError = "We couldn't load the latest attendance data, so these figures may be out of date.";
        }

        ParticipationReport = ReportingService.GetVolunteerParticipationReport();
        PendingRequests = ReportingService.GetPendingRequests();
        FulfilledRequests = ReportingService.GetFulfilledRequests();

        EventStatisticsList = OpportunityService
            .GetAllOpportunities()
            .Select(opportunity => ReportingService.GetEventStatistics(opportunity.Id))
            .ToList();

        await CacheVolunteerNamesAsync();
    }

    // Volunteers are identified by the domain's Guid VolunteerId, which is
    // expected to match the signed-in user's Identity Id (also a Guid,
    // stored as a string by ASP.NET Core Identity). This resolves that Id
    // to the person's real account name for display instead of a raw Guid.
    private async Task CacheVolunteerNamesAsync()
    {
        IEnumerable<Guid> volunteerIds = ParticipationReport
            .Select(summary => summary.VolunteerId)
            .Concat(PendingRequests.Select(request => request.VolunteerId))
            .Concat(FulfilledRequests.Select(request => request.VolunteerId))
            .Distinct();

        foreach (Guid volunteerId in volunteerIds)
        {
            if (_volunteerNames.ContainsKey(volunteerId))
            {
                continue;
            }

            ApplicationUser? user = await UserManager.FindByIdAsync(volunteerId.ToString());
            _volunteerNames[volunteerId] = user?.UserName ?? user?.Email ?? volunteerId.ToString();
        }
    }

    // Returns the cached display name for a volunteer, or the raw id if it hasn't been looked up yet.
    private string VolunteerName(Guid volunteerId)
    {
        return _volunteerNames.TryGetValue(volunteerId, out string? name)
            ? name
            : volunteerId.ToString();
    }

    // Returns an opportunity's title, or "Unknown event" if it can't be found.
    private string OpportunityTitle(Guid opportunityId)
    {
        return OpportunityService.FindOpportunityById(opportunityId)?.Title ?? "Unknown event";
    }
}
